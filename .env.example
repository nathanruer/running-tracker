# PostgreSQL
# DATABASE_URL: application role `app_user` (no BYPASSRLS) — every query is scoped to the
# signed-in user through row level security (prisma/migrations/v3/lot12_tenancy.sql).
# DIRECT_DATABASE_URL: owner role — migrations, authentication (login/register) and admin jobs.
DATABASE_URL=postgresql://app_user.<project-ref>:<app_user-password>@<host>:5432/postgres?connection_limit=5
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<owner-password>@<host>:5432/postgres?connection_limit=5
# Optional: distinct owner URL for the runtime admin client (defaults to DIRECT_DATABASE_URL)
# DATABASE_ADMIN_URL=

# Auth — 32+ random characters
JWT_SECRET=

# Coach IA — Google AI Studio par défaut dès que sa clé est là, bascule automatique
# sur l'autre fournisseur quand le premier limite le débit
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Optional model overrides
# AI_PROVIDER=google
# AI_MODEL=gemini-3-flash-preview
# AI_SUMMARY_MODEL=gemini-3.1-flash-lite
# AI_MAX_TOKENS=3000
# Output token budget per completion — keep max_tokens + prompt below the
# provider's TPM limit (Groq free tier: 8000/min; Google AI Studio: 250000/min)

# intervals.icu: no env key — each user connects their own API key
# from Profil → Compte (stored per-user in external_accounts)

# Optional
# LOG_LEVEL=info
# PLAYWRIGHT_BASE_URL=http://localhost:3000
